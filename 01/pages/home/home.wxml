<view class="page-root">
  <view class="home-back-wrap" bindtap="onHomeBackTap">
    <view class="home-back-arrow"></view>
  </view>

  <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false" enhanced="true">
    <view class="page-content">
      
      <!-- 大体量 AI 伴游互动舱 -->
      <view class="ai-hero-container">
        <!-- 欢迎语与引导 -->
        <view class="hero-text-area">
          <text class="hero-title">{{uiText.welcomeTitle}}</text>
          <view class="hero-subtitle-row">
            <text class="hero-subtitle-icon">📍</text>
            <text class="hero-subtitle">{{uiText.welcomeSubtitle}}</text>
          </view>
        </view>

        <!-- 核心 Canvas 节点及交互气泡 -->
        <view class="elephant-interaction-area {{isElephantRevealed ? 'revealed' : 'hidden'}}">
          <view class="elephant-wrapper" bindtap="handleTapElephant">
            <canvas id="lottie-canvas" class="elephant-canvas" type="2d" bindtap="handleTapElephant" style="width:160px;height:160px;margin:0 auto;" />
            <!-- 由小象触发的左侧气泡 -->
            <view class="elephant-tooltip {{isChatOpen ? 'show' : ''}}">
              <text>{{uiText.tooltip}}</text>
              <view class="tooltip-arrow"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="safety-card" bindtap="onOpenSecurityGuide">
        <view class="safety-header">
            <text class="safety-title">{{uiText.safetyTitle}}</text>
            <text class="safety-more" catchtap="onMoreTap">{{uiText.safetyMore}}</text>
        </view>
        <view class="safety-level-row">
          <text class="safety-level">{{uiText.safetyLevel}}</text>
          <text class="shield-icon">🛡</text>
        </view>
        <text class="safety-text">{{uiText.safetyText}}</text>
        <text class="safety-date">{{uiText.safetyDate}}</text>
      </view>

      <view class="landing-plan-card" bindtap="onTripPlanTap">
        <view class="landing-plan-copy">
          <text class="landing-plan-eyebrow">SAFE LANDING ASSISTANT</text>
          <text class="landing-plan-title">我的安全落地计划</text>
          <text class="landing-plan-desc">{{tripPreview.label}}</text>
        </view>
        <view class="landing-plan-progress"><text>{{tripPreview.progress}}%</text></view>
      </view>

      <view class="feature-block">
        <text class="feature-title">{{uiText.featureTitle}}</text>
        <view class="feature-grid">
          <block wx:for="{{uiText.features}}" wx:key="key">
            <view
              class="feature-item"
              bindtap="onFeatureTap"
              data-key="{{item.key}}"
              data-name="{{item.label}}"
              data-theme-start="{{item.themeStart}}"
              data-theme-end="{{item.themeEnd}}"
            >
              <view class="feature-icon-shell" style="background: {{item.bg}};">
                <view wx:if="{{item.key === 'health'}}" class="health-cross-mark">
                  <view class="health-cross-fill">
                    <view class="health-cross-h"></view>
                    <view class="health-cross-v"></view>
                  </view>
                  <view class="health-cross-glint"></view>
                </view>
                <text wx:else class="feature-icon">{{item.icon}}</text>
              </view>
              <text class="feature-label">{{item.label}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="emergency-row">
        <view class="emergency-card embassy" bindtap="onEmergencyTap" data-type="embassy">
          <view class="emergency-icon">🏛</view>
          <text class="en-text">{{uiText.embassySubLabel}}</text>
          <text class="zh-text">{{uiText.embassyLabel}}</text>
        </view>
        <view class="emergency-card hotline" bindtap="onEmergencyTap" data-type="hotline">
          <view class="emergency-icon">🚨</view>
          <text class="en-text">{{uiText.hotlineSubLabel}}</text>
          <text class="zh-text">{{uiText.hotlineLabel}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="custom-tabbar">
    <view class="tab-pill">
      <view class="tab-item active" bindtap="onTabTap" data-tab="home">
        <text class="tab-icon">🏠</text>
        <text class="tab-text">{{uiText.tabLabels.home}}</text>
      </view>
      <view class="tab-item" bindtap="onTabTap" data-tab="community">
        <text class="tab-icon">💬</text>
        <text class="tab-text">{{uiText.tabLabels.community}}</text>
      </view>
      <view class="tab-item center-item" bindtap="onTabTap" data-tab="publish">
        <view class="publish-btn"><text class="publish-plus">+</text></view>
        <text class="publish-text">{{uiText.tabLabels.publish}}</text>
      </view>
      <view class="tab-item" bindtap="onTabTap" data-tab="message">
        <text class="tab-icon">🗨</text>
        <text class="tab-text">{{uiText.tabLabels.message}}</text>
      </view>
      <view class="tab-item" bindtap="onTabTap" data-tab="profile">
        <text class="tab-icon">👤</text>
        <text class="tab-text">{{uiText.tabLabels.profile}}</text>
      </view>
    </view>
  </view>
</view>
