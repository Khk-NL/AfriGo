/* miniprogram/templates/tabbar.wxss */
.custom-tabbar {
    position: fixed;
    bottom: calc(constant(safe-area-inset-bottom) + 8px);
    bottom: calc(env(safe-area-inset-bottom) + 8px);
    left: 0;
    width: 100%;
    background: transparent;
    box-shadow: none;
    z-index: 9999;
    display: flex;
    justify-content: center;
    pointer-events: auto;
}

.tab-pill {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 66px;
    width: calc(100% - 32rpx);
    padding: 0 12rpx;
    box-sizing: border-box;
    border-radius: 24rpx;
    background: rgba(255, 255, 255, 0.97);
    border: 1rpx solid #dfe4e0;
    box-shadow: 0 8rpx 20rpx rgba(45, 58, 50, 0.08);
    pointer-events: auto;
}

.tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    color: #7a857e;
    font-size: 12px;
    transition: color 0.3s ease;
}

.tab-item.active {
    color: #4f6659;
}

.tab-icon {
    font-size: 20px;
    margin-bottom: 4rpx;
}

.tab-icon-image {
    width: 32rpx;
    height: 32rpx;
    margin-bottom: 4rpx;
}

.publish-icon-image {
    width: 38rpx;
    height: 38rpx;
}

.tab-text {
    font-size: 10px;
}

/* Center "Publish" button styling */
.center-item {
    position: relative;
    bottom: 0;
    width: auto;
    height: auto;
    border-radius: 50%;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    color: #4f6659;
}

.publish-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    background: #61786b;
    box-shadow: none;
}

.publish-plus {
    font-size: 38rpx;
    line-height: 1;
    color: #fff;
}

.publish-text {
    font-size: 20rpx;
    margin-top: 4rpx;
    color: #4a5568;
}
