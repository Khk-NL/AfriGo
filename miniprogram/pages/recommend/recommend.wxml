<view class="page-root">
  <view class="page-back-btn" bindtap="onGoHomeTap">
    <text class="page-back-icon">←</text>
    <text class="page-back-text">返回主界面</text>
  </view>

  <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false"
    refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="page-content">
      <view class="hero-card">
        <text class="hero-eyebrow">TRAVEL PICKS</text>
        <text class="hero-title">{{currentCountry}}·出行推荐</text>
        <text class="hero-subtitle">围绕美食、住宿、交通与购物，给你一份更适合落地使用的本地建议。</text>
        <view class="hero-chip-row">
          <text class="hero-chip">共 {{summaryCount}} 条</text>
          <text class="hero-chip">安全优先</text>
          <text class="hero-chip">可直接参考</text>
        </view>
      </view>

      <text wx:if="{{freshnessText}}" class="freshness-line">{{freshnessText}}</text>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">按类别筛选</text>
          <text class="section-subtitle">点选标签后只看你最需要的推荐内容</text>
        </view>

        <view class="recommend-search">
          <text class="recommend-search-icon">⌕</text>
          <input value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索名称、地点或内容..." />
        </view>

        <scroll-view class="tag-scroll" scroll-x="true" show-scrollbar="false">
          <view class="tag-row">
            <block wx:for="{{categories}}" wx:key="*this">
              <view class="tag-pill {{activeCategory === item ? 'active-pill' : ''}}" bindtap="onTagTap" data-tag="{{item}}">
                <text class="tag-text">{{item}}</text>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">本地推荐清单</text>
          <text class="section-subtitle">点击卡片查看地址与安全提示</text>
        </view>

        <view wx:if="{{loading}}" class="skeleton-list">
          <view class="skeleton-card"></view>
          <view class="skeleton-card"></view>
          <view class="skeleton-card"></view>
        </view>
        <block wx:elif="{{displayList.length}}">
          <block wx:for="{{displayList}}" wx:key="id">
            <view class="item-card recommend-card" bindtap="onCardTap" data-name="{{item.name}}" data-address="{{item.address}}" data-desc="{{item.desc}}" data-safety-tip="{{item.safetyTip}}">
              <view class="item-head">
                <text class="item-title">{{item.name}}</text>
                <text class="recommend-rating">{{item.rating}}</text>
              </view>

              <view class="item-meta">
                <text class="recommend-category">{{item.category}}</text>
                <text class="recommend-address">{{item.address}}</text>
              </view>

              <text class="item-desc">{{item.desc}}</text>

              <view class="item-note">
                <text class="recommend-note-label">💡 安全避坑：</text>
                <text class="recommend-note-text">{{item.safetyTip}}</text>
              </view>
              <view class="bookmark-action {{item.isBookmarked ? 'bookmarked' : ''}}" catchtap="onBookmarkTap" data-id="{{item.id}}">
                {{item.isBookmarked ? '★ 已收藏' : '☆ 收藏'}}
              </view>
            </view>
          </block>
        </block>

        <view wx:else class="empty-state">
          <text class="empty-icon">🧭</text>
          <text class="empty-title">{{noData ? '该国家暂无经核验的推荐资料' : '当前分类暂时没有内容'}}</text>
          <text class="empty-desc">{{noData ? '未核验内容不会从其他国家复制，请等待后台补充。' : '试试切换到“全部”或其他类别。'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
