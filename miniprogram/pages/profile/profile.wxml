<import src="../../templates/tabbar.wxml" />

<view class="profile-page">
    <scroll-view class="profile-scroll" scroll-y="true" show-scrollbar="false">
        <view class="profile-content">
            <view class="profile-hero">
                <view class="hero-topline">
                    <text class="hero-badge">{{uiText.heroBadge}}</text>
                    <text class="hero-date">{{uiText.memberSince}} {{memberSince}}</text>
                </view>

                <view class="identity-row">
                    <view class="avatar-shell">
                        <image wx:if="{{isLogin && userInfo.avatarUrl}}" class="avatar-image" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
                        <view wx:else class="avatar-fallback">{{language === 'en' ? 'T' : language === 'fr' ? 'V' : '旅'}}</view>
                    </view>

                    <view class="identity-copy">
                        <text class="hero-name">{{isLogin ? userInfo.nickName : uiText.guestName}}</text>
                        <text class="hero-subcopy">{{currentCountryLabel}} · {{currentCity}} · {{uiText.heroSubcopy}}</text>
                        <text class="hero-note">{{isLogin ? uiText.loggedInNote : uiText.guestSubcopy}}</text>
                    </view>
                </view>

                <view wx:if="{{isLogin}}" class="hero-status-pill">{{uiText.loggedInStatus}}</view>
                <view wx:else class="hero-status-pill hero-status-guest">{{uiText.guestStatus}}</view>

                <view class="stats-grid">
                    <block wx:for="{{profileStats}}" wx:key="label">
                        <view class="stat-card stat-{{item.tone}}">
                            <text class="stat-value">{{item.value}}</text>
                            <text class="stat-label">{{item.label}}</text>
                        </view>
                    </block>
                </view>
            </view>

            <view class="section-card quick-card">
                <view class="section-head">
                    <view>
                        <text class="section-title">{{uiText.quickTitle}}</text>
                        <text class="section-subtitle">{{uiText.quickSubtitle}}</text>
                    </view>
                </view>

                <view class="quick-grid">
                    <block wx:for="{{quickActions}}" wx:key="key">
                        <view class="quick-item quick-{{item.tone}}" bindtap="onQuickActionTap" data-key="{{item.key}}">
                            <image wx:if="{{item.iconImage}}" class="quick-icon-image" src="{{item.iconImage}}" mode="aspectFit" />
                            <text wx:else class="quick-icon">{{item.icon}}</text>
                            <text class="quick-label">{{item.label}}</text>
                            <text class="quick-meta">{{item.meta}}</text>
                        </view>
                    </block>
                </view>
            </view>

            <view class="section-card journey-card">
                <view class="section-head">
                    <view>
                        <text class="section-title">{{uiText.journeyTitle}}</text>
                        <text class="section-subtitle">{{uiText.journeySubtitle}}</text>
                    </view>
                </view>

                <view class="journey-banner">
                    <text class="journey-title">{{currentCountryLabel}} {{uiText.journeyBadgePrefix}}</text>
                    <text class="journey-desc">{{destinationInsight}}</text>
                    <view class="journey-chip-row">
                        <text class="journey-chip journey-chip-green">{{uiText.focusPrefix}}{{focusLabel}}</text>
                        <text class="journey-chip journey-chip-amber">{{uiText.riskPrefix}}{{riskLabel}}</text>
                    </view>
                </view>
            </view>

            <view class="section-card service-card">
                <view class="section-head">
                    <view>
                        <text class="section-title">{{uiText.serviceTitle}}</text>
                        <text class="section-subtitle">{{uiText.serviceSubtitle}}</text>
                    </view>
                </view>

                <block wx:for="{{serviceEntries}}" wx:key="title">
                    <view class="service-item" bindtap="onServiceTap" data-action="{{item.action}}" data-title="{{item.title}}">
                        <image wx:if="{{item.iconImage}}" class="service-icon-image" src="{{item.iconImage}}" mode="aspectFit" />
                        <text wx:else class="service-icon">{{item.icon}}</text>
                        <view class="service-copy">
                            <text class="service-title">{{item.title}}</text>
                            <text class="service-subtitle">{{item.subtitle}}</text>
                        </view>
                        <text class="service-arrow">›</text>
                    </view>
                </block>
            </view>

            <view wx:if="{{settingsVisible}}" class="section-card settings-card">
                <view class="section-head section-head-row">
                    <view>
                        <text class="section-title">{{settingsText.title}}</text>
                        <text class="section-subtitle">{{settingsText.subtitle}}</text>
                    </view>
                    <text class="settings-close" bindtap="onCloseSettings">{{settingsText.close}}</text>
                </view>
                <picker mode="selector" range="{{languageOptions}}" value="{{languageIndex}}" bindchange="onLanguageChange">
                    <view class="settings-row">
                        <view><text class="settings-title">{{settingsText.language}}</text><text class="settings-desc">{{languageOptions[languageIndex]}}</text></view>
                        <text class="service-arrow">›</text>
                    </view>
                </picker>
                <view class="settings-row">
                    <view><text class="settings-title">{{settingsText.reminders}}</text><text class="settings-desc">{{settingsText.remindersDesc}}</text></view>
                    <switch checked="{{remindersEnabled}}" bindchange="onReminderChange" color="#58c796" />
                </view>
                <view class="settings-row" bindtap="onPrivacyTap">
                    <view><text class="settings-title">{{settingsText.privacy}}</text><text class="settings-desc">{{settingsText.privacyDesc}}</text></view>
                    <text class="service-arrow">›</text>
                </view>
                <button wx:if="{{isLogin}}" class="delete-account-btn" bindtap="onDeleteAccount">{{settingsText.deleteAccount}}</button>
            </view>

            <view class="section-card bookmark-card">
                <view class="section-head section-head-row">
                    <view>
                        <text class="section-title">{{uiText.bookmarkTitle}}</text>
                        <text class="section-subtitle">{{uiText.bookmarkSubtitle}}</text>
                    </view>
                    <text class="section-pill">{{bookmarks.length}} 条</text>
                </view>

                <view wx:if="{{bookmarks.length === 0}}" class="empty-bookmarks">
                    <view class="empty-icon">✦</view>
                    <text class="empty-title">{{uiText.bookmarkEmptyTitle}}</text>
                    <text class="empty-desc">{{uiText.bookmarkEmptyDesc}}</text>
                </view>

                <block wx:else>
                    <block wx:for="{{bookmarks}}" wx:key="id">
                        <view class="bookmark-item" bindtap="onBookmarkTap" data-title="{{item.title}}">
                            <view class="bookmark-main">
                                <text class="bookmark-title">{{item.title}}</text>
                                <view class="bookmark-meta-row">
                                    <text class="bookmark-tag">{{item.category}}</text>
                                    <text class="bookmark-date">{{item.date}}</text>
                                </view>
                            </view>
                            <view class="bookmark-remove" catchtap="onRemoveBookmark" data-id="{{item.id}}">{{language === 'zh' ? '移除' : language === 'en' ? 'Remove' : 'Retirer'}}</view>
                        </view>
                    </block>
                </block>
            </view>

            <view wx:if="{{isLogin}}" class="section-card bookmark-card">
                <view class="section-head section-head-row">
                    <view>
                        <text class="section-title">我的动态</text>
                        <text class="section-subtitle">管理你发布的旅行记录</text>
                    </view>
                    <text class="section-pill">{{myPosts.length}} 条</text>
                </view>
                <view wx:if="{{myPosts.length === 0}}" class="empty-bookmarks">
                    <text class="empty-title">还没有发布动态</text>
                </view>
                <block wx:else>
                    <block wx:for="{{myPosts}}" wx:key="id">
                        <view class="bookmark-item">
                            <view class="bookmark-main">
                                <text class="bookmark-title">{{item.content || '图片动态'}}</text>
                                <text class="bookmark-date">{{item.createTime}}</text>
                            </view>
                            <view class="bookmark-remove" bindtap="onDeletePost" data-id="{{item.id}}">删除</view>
                        </view>
                    </block>
                </block>
            </view>

            <view class="section-card support-card">
                <view class="section-head">
                    <view>
                        <text class="section-title">{{uiText.supportTitle}}</text>
                        <text class="section-subtitle">{{uiText.supportSubtitle}}</text>
                    </view>
                </view>

                <view class="support-row">
                    <view class="support-action support-green" bindtap="onServiceTap" data-action="security" data-title="{{uiText.supportSecurityTitle}}">
                        <text class="support-title">{{uiText.supportSecurityTitle}}</text>
                        <text class="support-desc">{{uiText.supportSecurityDesc}}</text>
                    </view>
                    <view class="support-action support-sand" bindtap="onServiceTap" data-action="local-info" data-title="{{uiText.supportLocalInfoTitle}}">
                        <text class="support-title">{{uiText.supportLocalInfoTitle}}</text>
                        <text class="support-desc">{{uiText.supportLocalInfoDesc}}</text>
                    </view>
                </view>

                <button wx:if="{{isLogin}}" class="ghost-logout-btn" bindtap="onLogout">{{uiText.logout}}</button>

                <view wx:if="{{isAdmin}}" class="admin-entry-card" bindtap="onAdminCenterTap">
                    <view class="admin-entry-copy">
                        <text class="admin-entry-title">{{uiText.adminEntrance}}</text>
                        <text class="admin-entry-desc">{{uiText.adminEntranceDesc}}</text>
                    </view>
                    <text class="admin-entry-arrow">›</text>
                </view>
            </view>
        </view>
    </scroll-view>
</view>

<template is="tabbar" data="{{ activeTab: 'profile', tabTexts: uiText.tabLabels, tabIconImages: uiText.tabIconImages }}" />
