/**app.wxss**/

/* ------------------------------------------------------------------
 * 设计变量：暖砂底 + 大地色强调。
 * 底色不再是冷灰，强调色用陶土与赭黄，绿色保留为品牌主色。
 * 想调整强弱只改这一段。
 * ------------------------------------------------------------------ */
page {
  --safe-top: max(env(safe-area-inset-top), 24px);

  /* 底色与描边 */
  --sand-50: #fffdf8;
  --sand-100: #f7f1e7;
  --sand-200: #f2ece2;
  --sand-300: #e6dac7;
  --sand-400: #d9c9b1;

  /* 文字 */
  --ink-900: #2a231c;
  --ink-700: #3c332a;
  --ink-600: #5c5247;
  --ink-500: #7b6f62;
  --ink-400: #948779;

  /* 品牌与大地色 */
  --acacia: #2f4a3c;
  --acacia-soft: #4f6b52;
  --clay: #b4552f;
  --clay-soft: #c9714a;
  --ochre: #d8a13a;
  --ochre-soft: #e6c179;

  /* 阴影用暖褐，不用灰 */
  --shadow-soft: 0 10rpx 24rpx rgba(90, 60, 30, .08);
  --shadow-card: 0 14rpx 34rpx rgba(90, 60, 30, .10);

  background-color: var(--sand-100);
  color: var(--ink-900);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

/* ------------------------------------------------------------------
 * 非洲母题
 * ------------------------------------------------------------------ */

/* 织物几何条：Kente 风格的锯齿编织，纯 CSS，不需要图片 */
.africa-band {
  height: 12rpx;
  border-radius: 999rpx;
  background-image:
    repeating-linear-gradient(135deg, var(--clay) 0 7rpx, transparent 7rpx 14rpx),
    repeating-linear-gradient(45deg, var(--ochre) 0 7rpx, transparent 7rpx 14rpx),
    linear-gradient(90deg, var(--acacia), var(--acacia));
  opacity: .9;
}

/* 细分隔线：一排菱形点，替代普通的 1rpx 直线 */
.africa-divider {
  height: 8rpx;
  background-image: repeating-linear-gradient(90deg, var(--sand-400) 0 4rpx, transparent 4rpx 16rpx);
  opacity: .8;
}

/* 稀树草原天际线：金合欢剪影 + 落日，放在卡片底部当装饰 */
.africa-horizon {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  background-repeat: no-repeat;
  background-position: bottom center;
  background-size: 100% 100%;
  pointer-events: none;
  background-image: url("data:image/svg+xml;base64,");
}

/* 落日暖光：hero 顶部一层赭黄、左下角一层陶土 */
.africa-glow {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 100%;
  pointer-events: none;
  background:
    radial-gradient(120% 80% at 82% 12%, rgba(216, 161, 58, .30) 0%, rgba(216, 161, 58, 0) 62%),
    radial-gradient(90% 70% at 6% 96%, rgba(180, 85, 47, .16) 0%, rgba(180, 85, 47, 0) 60%);
}

.africa-eyebrow {
  color: var(--clay);
}
