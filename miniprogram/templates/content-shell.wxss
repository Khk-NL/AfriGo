/* Shared travel content shell */
page {
  background: #f4f5f3;
  color: #27332d;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC', 'Helvetica Neue', sans-serif;
}

.page-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f4f5f3;
}

.page-scroll {
  min-height: 100vh;
}

.page-content {
  box-sizing: border-box;
  width: 100%;
  padding: calc(var(--safe-top) + 98rpx) 24rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.page-back-btn {
  position: absolute;
  left: 24rpx;
  top: calc(var(--safe-top) + 24rpx);
  z-index: 20;
  min-width: 150rpx;
  height: 64rpx;
  padding: 0 18rpx 0 14rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dfe4e0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.page-back-btn:active {
  transform: translateY(1rpx);
}

.page-back-icon {
  width: 28rpx;
  color: #536158;
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.page-back-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #536158;
}

.hero-card,
.section-card,
.empty-state {
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e1e5e2;
}

.hero-card {
  padding: 32rpx 30rpx 28rpx;
}

.hero-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #758178;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.16;
  color: #27332d;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #748078;
  line-height: 1.5;
}

.hero-summary {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #59645e;
  line-height: 1.7;
}

.hero-chip-row,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-chip,
.tag-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.hero-chip-row {
  margin-top: 20rpx;
}

.tag-text {
  color: inherit;
  font-size: inherit;
  font-weight: 600;
  line-height: 1;
}

.hero-chip {
  color: #5f7066;
  background: #edf1ee;
}

.section-card {
  margin-top: 26rpx;
  padding: 28rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #27332d;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7f8983;
  line-height: 1.55;
}

.search-shell {
  height: 74rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e1e5e2;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.search-icon {
  color: #879189;
  margin-right: 10rpx;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  font-size: 28rpx;
  color: #243447;
}

.search-placeholder {
  color: #b2aaa0;
}

.clear-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #c0c6cf;
  padding: 0 6rpx 0 16rpx;
}

.tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.tag-row {
  flex-wrap: nowrap;
  padding: 2rpx 2rpx 10rpx;
}

.tag-pill {
  flex-shrink: 0;
  color: #5f6b64;
  background: #eef1ef;
  border: 1rpx solid #e0e5e1;
}

.tag-pill:active {
  transform: translateY(1rpx);
}

.item-card {
  padding: 26rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #e1e5e2;
}

.item-card + .item-card {
  margin-top: 18rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.item-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  color: #27332d;
  font-weight: 700;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.item-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.item-note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 240, 243, 0.72);
  font-size: 22rpx;
  color: #3a4758;
  line-height: 1.6;
}

.empty-state {
  margin-top: 18rpx;
  padding: 42rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 44rpx;
}

.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #243447;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

