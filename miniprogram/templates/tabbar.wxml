<template name="tabbar">
    <view class="custom-tabbar" style="z-index: 9999;">
        <view class="tab-pill">
            <view class="tab-item {{activeTab === 'home' ? 'active' : ''}}" bindtap="onTabTap" data-tab="home">
                <view class="af-icon af-tab-home"></view>
                <text class="tab-text">{{tabTexts.home || '首页'}}</text>
            </view>

            <view class="tab-item {{activeTab === 'community' ? 'active' : ''}}" bindtap="onTabTap" data-tab="community">
                <view class="af-icon af-tab-community"></view>
                <text class="tab-text">{{tabTexts.community || '社区'}}</text>
            </view>

            <view class="tab-item center-item" bindtap="onTabTap" data-tab="publish">
                <view class="publish-btn"><view class="af-icon af-icon-sm af-tab-publish-inverse"></view></view>
                <text class="publish-text">{{tabTexts.publish || '发布'}}</text>
            </view>

            <view class="tab-item {{activeTab === 'message' ? 'active' : ''}}" bindtap="onTabTap" data-tab="message">
                <view class="af-icon af-tab-message"></view>
                <text class="tab-text">{{tabTexts.message || '消息'}}</text>
            </view>

            <view class="tab-item {{activeTab === 'profile' ? 'active' : ''}}" bindtap="onTabTap" data-tab="profile">
                <view class="af-icon af-tab-profile"></view>
                <text class="tab-text">{{tabTexts.profile || '个人中心'}}</text>
            </view>
        </view>
    </view>
</template>
