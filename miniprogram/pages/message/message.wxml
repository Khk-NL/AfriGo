<import src="../../templates/tabbar.wxml" />

<view class="page-root">
  <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false">
    <view class="page-content message-content">
      <view class="hero-card message-hero">
        <text class="hero-eyebrow">NOTIFICATIONS</text>
        <text class="hero-title">{{uiText.title}}</text>
        <text class="hero-summary">{{uiText.subtitle}}</text>
        <view wx:if="{{unreadCount > 0}}" class="unread-pill"><text>{{unreadCount}} 条未读</text></view>
      </view>

      <view wx:if="{{!remindersEnabled}}" class="notice-hint">
        <text>应用内未读提醒已关闭，消息内容仍会保留。</text>
      </view>

      <view class="notice-list">
        <view
          wx:for="{{notices}}"
          wx:key="id"
          class="notice-card {{item.unread ? 'is-unread' : ''}}"
          bindtap="readNotice"
          data-id="{{item.id}}"
        >
          <view class="notice-top">
            <text class="card-tag tag-{{item.tone}}">{{item.type}}</text>
            <text class="notice-time">{{item.time}}</text>
          </view>
          <text class="notice-title">{{item.title}}</text>
          <text class="notice-desc">{{item.content}}</text>
          <view wx:if="{{item.unread && remindersEnabled}}" class="unread-dot"></view>
        </view>
      </view>

      <view wx:if="{{isLoading}}" class="section-card empty-state">
        <text class="empty-title">正在加载消息…</text>
      </view>

      <view wx:elif="{{notices.length === 0}}" class="section-card empty-state">
        <text class="empty-title">{{uiText.empty}}</text>
        <text class="empty-desc">有新的安全预警或办事动态时，会出现在这里。</text>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>
</view>

<template is="tabbar" data="{{activeTab: 'message', tabTexts: uiText.tabLabels, tabIconImages: uiText.tabIconImages}}"/>
<elephant-pet />
