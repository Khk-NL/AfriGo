.af-icon {
  display: inline-block;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.af-icon-lg { width: 56rpx; height: 56rpx; }
.af-icon-sm { width: 34rpx; height: 34rpx; }

