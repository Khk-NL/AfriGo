<view class="page-root">
        <view class="home-back-wrap" bindtap="onBackTap"><view class="home-back-arrow"></view></view>

        <scroll-view class="page-scroll" scroll-y="true">
                <view class="page-content">
                        <view class="header-block">
                                <text class="title">{{currentCountry}}·必游之地</text>
                                <view class="sub-row">
                                        <text class="pin-icon">📸</text>
                                        <text class="subtitle">专业攻略 | 避坑指南 | 离线地图</text>
                                </view>
                        </view>

                        <view class="search-block">
                                <view class="search-shell">
                                        <text class="search-icon">⌕</text>
                                        <input class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索景点或体验..." />
                                </view>
                        </view>

                        <scroll-view class="attr-tag-scroll" scroll-x="true" show-scrollbar="false">
                                <view class="attr-filter-row">
                                        <block wx:for="{{tags}}" wx:key="*this">
                                                <view class="attr-filter {{activeTag === item ? 'active' : ''}}" bindtap="onTagTap" data-tag="{{item}}">{{item}}</view>
                                        </block>
                                </view>
                        </scroll-view>

                        <view class="attraction-list">
                                <block wx:for="{{list}}" wx:key="id">
                                        <view class="attr-card" bindtap="onAttrTap" data-id="{{item.id}}">
                                                <view class="attr-img-box">
                                                        <image class="attr-img" src="{{item.image}}" mode="aspectFill" />
                                                        <view class="attr-tag-box">
                                                                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                                                                        <text class="attr-tag">{{tag}}</text>
                                                                </block>
                                                        </view>
                                                </view>

                                                <view class="attr-info">
                                                        <text class="attr-name">{{item.name}}</text>
                                                        <text class="attr-desc">{{item.desc}}</text>
                                                        <view class="attr-tips">
                                                                <text class="tips-icon">💡</text>
                                                                <text class="tips-text">{{item.tips}}</text>
                                                        </view>
                                                        <view class="bookmark-action {{item.isBookmarked ? 'bookmarked' : ''}}" catchtap="onBookmarkTap" data-id="{{item.id}}">
                                                                {{item.isBookmarked ? '★ 已收藏' : '☆ 收藏'}}
                                                        </view>
                                                </view>
                                        </view>
                                </block>
                                <view wx:if="{{!list.length}}" class="attr-empty">
                                        <text class="attr-empty-title">{{noData ? '该国家暂无经核验的景点资料' : '没有匹配的景点'}}</text>
                                        <text class="attr-empty-desc">{{noData ? '可稍后重试远程同步，或由管理员补充来源明确的数据。' : '请更换关键词或选择“全部”。'}}</text>
                                </view>
                        </view>
                </view>
        </scroll-view>
</view>
