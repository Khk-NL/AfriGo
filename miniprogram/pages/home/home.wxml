<view class="page-root">
  <view class="home-topbar">
    <view class="home-back-wrap" bindtap="onHomeBackTap"><text class="home-back-icon">←</text></view>
    <view class="destination-pill"><text>📍</text><text>{{currentCountryZh}}</text></view>
  </view>

  <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false"
    refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="page-content">
      <view class="sync-line">
        <text>{{syncText}}</text>
      </view>

      <view class="ai-hero-container">
        <image wx:if="{{heroCoverImage}}" class="hero-cover-image" src="{{heroCoverImage}}" mode="aspectFill" />
        <view class="hero-cover-mask"></view>
        <view class="hero-horizon"></view>
        <view class="hero-text-area">
          <text class="hero-kicker">AFRIGO · 非行智航</text>
          <text class="hero-title">{{uiText.welcomeTitle}}</text>
          <text class="hero-subtitle">{{uiText.welcomeSubtitle}}</text>
        </view>
      </view>

      <view class="africa-band hero-band"></view>

      <view class="safety-card" bindtap="onOpenSecurityGuide">
        <view class="safety-main"><text class="safety-icon">🛡️</text><view><text class="safety-title">{{uiText.safetyTitle}}</text><text class="safety-level">{{uiText.safetyLevel}} · {{uiText.safetyDate}}</text></view></view>
        <text class="safety-more" catchtap="onMoreTap">{{uiText.safetyMore}} ›</text>
      </view>

      <view wx:if="{{riskBanner}}" class="risk-banner risk-{{riskBanner.severity}}" bindtap="onOpenSecurityGuide">
        <view class="risk-banner-head">
          <text class="risk-banner-tag">实时风险提醒</text>
          <text class="risk-banner-date">{{riskBanner.publishedAt}}</text>
        </view>
        <text class="risk-banner-title">{{riskBanner.title}}</text>
        <text class="risk-banner-source" wx:if="{{riskBanner.sourceName}}">来源：{{riskBanner.sourceName}}</text>
      </view>

      <view class="home-section">
        <view class="home-section-head"><view><text class="home-section-title">旅中快捷工具</text><text class="home-section-subtitle">常用能力直接进入，不再藏在工具箱里</text></view></view>
        <view class="journey-tool-grid">
          <view wx:for="{{journeyTools}}" wx:key="key" class="journey-tool-card" data-section="{{item.key}}" bindtap="onJourneyToolTap">
            <view class="af-icon af-icon-{{item.key}}"></view>
            <view class="tool-copy"><text class="tool-title">{{item.label}}</text><text class="tool-desc">{{item.description}}</text></view>
          </view>
        </view>
      </view>

      <view class="landing-plan-card primary-plan-card" bindtap="onTripPlanTap">
        <view class="landing-plan-copy"><text class="landing-plan-eyebrow">BEFORE YOU GO</text><text class="landing-plan-title">我的安全落地计划</text><text class="landing-plan-desc">{{tripPreview.label}}</text></view>
        <view class="landing-plan-progress"><text>{{tripPreview.progress}}%</text></view>
      </view>

      <view class="home-section">
        <view class="home-section-head"><view><text class="home-section-title">行程服务</text><text class="home-section-subtitle">复盘、服务对接与信息核验</text></view></view>
        <view class="service-list">
          <view wx:for="{{homeServices}}" wx:key="key" class="service-row" bindtap="onHomeServiceTap" data-key="{{item.key}}"><view class="af-icon af-icon-{{item.key}}"></view><view><text class="service-row-title">{{item.title}}</text><text class="service-row-desc">{{item.description}}</text></view><text class="row-arrow">›</text></view>
        </view>
      </view>

      <view class="feature-block">
        <text class="feature-title">{{uiText.featureTitle}}</text>
        <view class="feature-grid">
          <view wx:for="{{uiText.features}}" wx:key="key" class="feature-item" bindtap="onFeatureTap" data-key="{{item.key}}" data-name="{{item.label}}">
            <view class="feature-icon-shell">
              <image wx:if="{{item.iconImage}}" class="feature-icon-image" src="{{item.iconImage}}" mode="aspectFit" />
              <text wx:else class="feature-icon">{{item.icon}}</text>
            </view>
            <text class="feature-label">{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view class="custom-tabbar">
    <view class="tab-pill">
      <view class="tab-item {{activeTab === 'home' ? 'active' : ''}}" bindtap="onTabTap" data-tab="home"><view class="af-icon af-tab-home"></view><text class="tab-text">{{uiText.tabLabels.home}}</text></view>
      <view class="tab-item {{activeTab === 'community' ? 'active' : ''}}" bindtap="onTabTap" data-tab="community"><view class="af-icon af-tab-community"></view><text class="tab-text">{{uiText.tabLabels.community}}</text></view>
      <view class="tab-item center-item" bindtap="onTabTap" data-tab="publish"><view class="publish-btn"><view class="af-icon af-icon-sm af-tab-publish-inverse"></view></view><text class="publish-text">{{uiText.tabLabels.publish}}</text></view>
      <view class="tab-item {{activeTab === 'message' ? 'active' : ''}}" bindtap="onTabTap" data-tab="message"><view class="af-icon af-tab-message"></view><text class="tab-text">{{uiText.tabLabels.message}}</text></view>
      <view class="tab-item {{activeTab === 'profile' ? 'active' : ''}}" bindtap="onTabTap" data-tab="profile"><view class="af-icon af-tab-profile"></view><text class="tab-text">{{uiText.tabLabels.profile}}</text></view>
    </view>
  </view>
  <elephant-pet />
</view>
