@import "../../templates/tabbar.wxss";

.publish-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
        radial-gradient(circle at 18% 12%, rgba(255, 205, 109, 0.7) 0%, rgba(255, 205, 109, 0) 30%),
        radial-gradient(circle at 84% 18%, rgba(231, 111, 81, 0.3) 0%, rgba(231, 111, 81, 0) 26%),
        linear-gradient(180deg, #fff7ef 0%, #fff1df 38%, #fff8f1 100%);
}

.sunset-flow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    transform-origin: center;
}

.flow-one {
    top: -120rpx;
    left: -100rpx;
    width: 520rpx;
    height: 520rpx;
    background: radial-gradient(circle at 40% 40%, rgba(255, 183, 3, 0.92) 0%, rgba(255, 183, 3, 0.34) 40%, rgba(255, 183, 3, 0) 74%);
    animation: halo-drift-a 7.2s ease-in-out infinite;
}

.flow-two {
    top: 180rpx;
    right: -100rpx;
    width: 420rpx;
    height: 420rpx;
    background: radial-gradient(circle at 50% 50%, rgba(231, 111, 81, 0.72) 0%, rgba(231, 111, 81, 0.24) 44%, rgba(231, 111, 81, 0) 78%);
    animation: halo-drift-b 6.4s ease-in-out infinite;
}

.flow-three {
    bottom: 260rpx;
    left: 80rpx;
    width: 360rpx;
    height: 360rpx;
    background: radial-gradient(circle at 50% 50%, rgba(255, 239, 221, 0.94) 0%, rgba(255, 239, 221, 0.2) 50%, rgba(255, 239, 221, 0) 82%);
    animation: halo-drift-c 5.8s ease-in-out infinite;
}

.ambient {
    position: absolute;
    border-radius: 50%;
    opacity: 0.88;
    pointer-events: none;
    transform-origin: center;
}

.ambient-one {
    top: 40rpx;
    left: -40rpx;
    width: 360rpx;
    height: 360rpx;
    background: rgba(255, 240, 220, 0.62);
    animation: ambient-pulse-a 4.6s ease-in-out infinite;
}

.ambient-two {
    top: 420rpx;
    right: -40rpx;
    width: 280rpx;
    height: 280rpx;
    background: rgba(255, 193, 130, 0.34);
    animation: ambient-pulse-b 4.1s ease-in-out infinite;
}

.ambient-three {
    top: 900rpx;
    left: 140rpx;
    width: 240rpx;
    height: 240rpx;
    background: rgba(255, 248, 239, 0.84);
    animation: ambient-pulse-c 5s ease-in-out infinite;
}

.light-ray {
    position: absolute;
    pointer-events: none;
    transform: rotate(-18deg);
    border-radius: 999rpx;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.46) 0%, rgba(255, 243, 226, 0.1) 100%);
    transform-origin: center;
}

.ray-one {
    top: -60rpx;
    left: 120rpx;
    width: 120rpx;
    height: 520rpx;
    animation: ray-sway-a 6.8s ease-in-out infinite;
}

.ray-two {
    top: 140rpx;
    right: 120rpx;
    width: 86rpx;
    height: 420rpx;
    opacity: 0.7;
    animation: ray-sway-b 5.4s ease-in-out infinite;
}

.ray-three {
    top: 420rpx;
    left: 260rpx;
    width: 66rpx;
    height: 320rpx;
    opacity: 0.44;
    animation: ray-sway-c 4.8s ease-in-out infinite;
}

@keyframes halo-drift-a {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 0.88;
    }
    35% {
        transform: translate(18rpx, 14rpx) scale(1.08);
        opacity: 1;
    }
    70% {
        transform: translate(-12rpx, 28rpx) scale(0.94);
        opacity: 0.78;
    }
    100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.88;
    }
}

@keyframes halo-drift-b {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 0.82;
    }
    30% {
        transform: translate(-24rpx, 10rpx) scale(1.12);
        opacity: 0.98;
    }
    68% {
        transform: translate(16rpx, -20rpx) scale(0.92);
        opacity: 0.68;
    }
    100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.82;
    }
}

@keyframes halo-drift-c {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 0.76;
    }
    40% {
        transform: translate(14rpx, -18rpx) scale(1.1);
        opacity: 0.96;
    }
    75% {
        transform: translate(-18rpx, 16rpx) scale(0.9);
        opacity: 0.66;
    }
    100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.76;
    }
}

@keyframes ambient-pulse-a {
    0%,
    100% {
        transform: scale(1);
        opacity: 0.72;
    }
    50% {
        transform: scale(1.16);
        opacity: 0.98;
    }
}

@keyframes ambient-pulse-b {
    0%,
    100% {
        transform: scale(0.94) translate(0, 0);
        opacity: 0.38;
    }
    50% {
        transform: scale(1.18) translate(-10rpx, 12rpx);
        opacity: 0.72;
    }
}

@keyframes ambient-pulse-c {
    0%,
    100% {
        transform: scale(1) translate(0, 0);
        opacity: 0.7;
    }
    50% {
        transform: scale(1.22) translate(10rpx, -10rpx);
        opacity: 1;
    }
}

@keyframes ray-sway-a {
    0%,
    100% {
        transform: rotate(-18deg) translateY(0);
        opacity: 0.5;
    }
    50% {
        transform: rotate(-14deg) translateY(18rpx);
        opacity: 0.84;
    }
}

@keyframes ray-sway-b {
    0%,
    100% {
        transform: rotate(-18deg) translateY(0);
        opacity: 0.54;
    }
    50% {
        transform: rotate(-22deg) translateY(-14rpx);
        opacity: 0.82;
    }
}

@keyframes ray-sway-c {
    0%,
    100% {
        transform: rotate(-18deg) translateY(0);
        opacity: 0.34;
    }
    50% {
        transform: rotate(-11deg) translateY(12rpx);
        opacity: 0.62;
    }
}

.publish-scroll {
    position: relative;
    z-index: 1;
    height: 100vh;
}

.publish-shell {
    padding: calc(env(safe-area-inset-top) + 26rpx) 28rpx calc(env(safe-area-inset-bottom) + 220rpx);
    box-sizing: border-box;
}

.top-nav {
    padding-top: 10rpx;
}

.top-nav-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.top-nav-caption {
    display: block;
    color: rgba(129, 82, 49, 0.78);
    font-size: 22rpx;
    font-weight: 700;
    letter-spacing: 1.2rpx;
}

.top-nav-title {
    display: block;
    margin-top: 12rpx;
    color: #2d211d;
    font-size: 58rpx;
    line-height: 1.1;
    font-weight: 800;
}

.draft-chip {
    padding: 12rpx 20rpx;
    border-radius: 999rpx;
    background: rgba(255, 248, 241, 0.52);
    border: 1rpx solid rgba(255, 255, 255, 0.44);
    box-shadow: 0 10rpx 24rpx rgba(213, 166, 109, 0.18);
}

.draft-chip-text {
    color: #9f6945;
    font-size: 20rpx;
    font-weight: 700;
}

.top-nav-subtitle {
    display: block;
    margin-top: 18rpx;
    color: rgba(92, 67, 59, 0.78);
    font-size: 24rpx;
    line-height: 1.7;
}

.compose-card {
    margin-top: 34rpx;
    padding: 32rpx;
    border-radius: 38rpx;
    background: rgba(255, 255, 255, 0.34);
    border: 1rpx solid rgba(255, 255, 255, 0.42);
    box-shadow: 0 36rpx 80rpx rgba(160, 108, 67, 0.2), 0 12rpx 30rpx rgba(255, 255, 255, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.46);
}

.compose-label {
    display: block;
    color: rgba(117, 82, 65, 0.86);
    font-size: 22rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.compose-textarea {
    width: 100%;
    min-height: 180rpx;
    margin-top: 18rpx;
    color: #2d211d;
    font-size: 34rpx;
    line-height: 1.6;
}

.compose-placeholder {
    color: rgba(122, 95, 84, 0.56);
    font-size: 34rpx;
}

.media-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 26rpx;
}

.media-title {
    color: #392824;
    font-size: 26rpx;
    font-weight: 700;
}

.media-meta {
    color: rgba(132, 98, 83, 0.62);
    font-size: 20rpx;
}

.upload-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 18rpx;
}

.upload-cell {
    position: relative;
    width: 48.2%;
    height: 226rpx;
    margin-bottom: 18rpx;
    border-radius: 28rpx;
    overflow: hidden;
    box-sizing: border-box;
}

.upload-cell-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2rpx dashed rgba(160, 114, 86, 0.28);
    background: rgba(255, 251, 248, 0.24);
}

.upload-cell-filled {
    box-shadow: 0 16rpx 34rpx rgba(170, 126, 87, 0.18);
}

.upload-preview {
    width: 100%;
    height: 100%;
}

.remove-chip {
    position: absolute;
    top: 14rpx;
    right: 14rpx;
    width: 42rpx;
    height: 42rpx;
    border-radius: 21rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(53, 33, 28, 0.54);
}

.remove-chip-text {
    color: #ffffff;
    font-size: 28rpx;
    line-height: 1;
}

.upload-plus {
    color: #b9774d;
    font-size: 58rpx;
    line-height: 1;
    font-weight: 300;
}

.upload-label {
    display: block;
    margin-top: 12rpx;
    color: #6c4f43;
    font-size: 24rpx;
    font-weight: 700;
}

.upload-hint {
    display: block;
    margin-top: 8rpx;
    color: rgba(118, 95, 86, 0.62);
    font-size: 20rpx;
}

.submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 96rpx;
    margin-top: 10rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #cf8a42 0%, #a86436 100%);
    box-shadow: 0 18rpx 34rpx rgba(186, 117, 61, 0.34);
}

.submit-btn-text {
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.sos-reflection {
    width: 380rpx;
    height: 44rpx;
    margin: 22rpx auto 0;
    border-radius: 999rpx;
    background: rgba(217, 4, 41, 0.1);
    box-shadow: 0 -10rpx 28rpx rgba(217, 4, 41, 0.12);
}

.bottom-space {
    height: 120rpx;
}

.sos-pill {
    position: fixed;
    right: 28rpx;
    bottom: calc(env(safe-area-inset-bottom) + 164rpx);
    z-index: 6;
    display: flex;
    align-items: center;
    padding: 16rpx 24rpx 16rpx 16rpx;
    border-radius: 999rpx;
    background: #d90429;
    box-shadow: 0 18rpx 42rpx rgba(217, 4, 41, 0.34);
}

.sos-shield {
    width: 46rpx;
    height: 46rpx;
    border-radius: 23rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.18);
    border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.sos-shield-text {
    color: #ffffff;
    font-size: 22rpx;
    font-weight: 700;
}

.sos-pill-text {
    margin-left: 12rpx;
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 700;
}

.custom-tabbar {
    bottom: calc(env(safe-area-inset-bottom) + 14px) !important;
}

.tab-pill {
    background: rgba(255, 250, 244, 0.92);
    border: 1rpx solid rgba(255, 255, 255, 0.88);
    box-shadow: 0 16rpx 34rpx rgba(180, 142, 109, 0.18);
}

.tab-item {
    color: #9b7b67;
}

.tab-item.active {
    color: #bb764b;
}

.tab-icon {
    font-size: 34rpx;
}

.tab-text {
    font-size: 20rpx;
}

.publish-btn {
    background: linear-gradient(135deg, #cf8a42 0%, #a86436 100%);
    box-shadow: 0 12rpx 24rpx rgba(186, 117, 61, 0.24);
}

.publish-plus {
    color: #ffffff;
}

.publish-text {
    color: #7a5a49;
}
.submit-btn-disabled {
  opacity: 0.65;
}

/* 9:16 mobile minimal theme */
.publish-page { background: #f4f5f3; }
.sunset-flow, .ambient, .light-ray { display: none; }
.publish-shell { padding: calc(env(safe-area-inset-top) + 24rpx) 24rpx calc(env(safe-area-inset-bottom) + 190rpx); }
.top-nav-caption { color: #758078; }
.top-nav-title { color: #27332d; font-size: 46rpx; }
.top-nav-subtitle { color: #6f7a73; }
.draft-chip { background: #ecefeb; border: 1rpx solid #dfe4e0; box-shadow: none; }
.draft-chip-text { color: #68756d; }
.compose-card { padding: 26rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #e1e5e2; box-shadow: none; }
.compose-label, .media-title, .upload-label { color: #536158; }
.compose-textarea { color: #27332d; font-size: 29rpx; }
.upload-cell { border-radius: 20rpx; }
.upload-cell-empty { background: #f1f3f1; border-color: #cfd7d1; }
.upload-plus { color: #667b6f; }
.submit-btn { border-radius: 22rpx; background: #61786b; box-shadow: none; }
.tab-item.active { color: #4f6659; }
.publish-btn { background: #61786b; box-shadow: none; }
.publish-text { color: #647169; }
