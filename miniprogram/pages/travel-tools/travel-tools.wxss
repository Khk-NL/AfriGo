@import "../../templates/content-shell.wxss";

.tool-hero { background: #f2ece2; }
.tool-section-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 20rpx; }
.tool-section-pill { min-width: 0; padding: 16rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #657069; background: #fffdf8; border: 1rpx solid #e6dac7; font-size: 21rpx; }
.tool-section-pill.active { color: #33483d; background: #e7ede9; border-color: #c9d5cd; }
.show-all-link { margin-top: 14rpx; text-align: center; color: #61766a; font-size: 21rpx; }
.place-card { padding: 20rpx; border-radius: 20rpx; background: #f7faf8; border: 1rpx solid #dcebe2; }
.place-name,
.place-address { display: block; }
.place-name { color: #3c332a; font-size: 28rpx; font-weight: 700; }
.place-address { margin-top: 8rpx; color: #7b6f62; font-size: 22rpx; line-height: 1.5; }
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }
.tool-button,
.mini-button,
.translate-button,
.emergency-button { border: none; }
.tool-button::after,
.mini-button::after,
.translate-button::after,
.emergency-button::after { border: none; }
.tool-button { min-height: 76rpx; padding: 0 16rpx; border-radius: 20rpx; color: #39775b; background: #edf7f1; font-size: 23rpx; display: flex; align-items: center; justify-content: center; }
.tool-button.primary { color: #fff; background: #4d5b49; }
.route-summary { margin-top: 16rpx; padding: 16rpx; border-radius: 18rpx; display: flex; justify-content: space-between; gap: 12rpx; background: #eef2ef; color: #52645a; font-size: 22rpx; }
.offline-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.offline-row > view { flex: 1; }
.offline-status,
.offline-time { display: block; }
.offline-status { color: #3c332a; font-size: 27rpx; font-weight: 700; }
.offline-time { margin-top: 8rpx; color: #7a8491; font-size: 20rpx; word-break: break-all; }
.mini-button { margin: 0; padding: 0 20rpx; border-radius: 999rpx; color: #fff; background: #5f7f70; font-size: 22rpx; }
.language-row { display: flex; align-items: center; justify-content: center; gap: 18rpx; }
.language-picker { min-width: 200rpx; padding: 16rpx; text-align: center; border-radius: 18rpx; color: #5c5247; background: #f4f1f9; font-size: 24rpx; }
.language-arrow { color: #8b7a67; font-size: 30rpx; }
.translate-input { box-sizing: border-box; width: 100%; height: 210rpx; margin-top: 18rpx; padding: 20rpx; border-radius: 20rpx; background: #fbf7f0; border: 1rpx solid #e6dac7; font-size: 25rpx; line-height: 1.6; }
.translate-button { margin-top: 16rpx; color: #fff; background: #4d5b49; border-radius: 20rpx; font-size: 25rpx; }
.translation-result { margin-top: 16rpx; padding: 22rpx; border-radius: 20rpx; color: #3c332a; background: #f2ece2; font-size: 27rpx; line-height: 1.6; }
.copy-tip { display: block; margin-top: 12rpx; color: #748078; font-size: 20rpx; }
.phrase-link { margin-top: 18rpx; text-align: center; color: #5b7064; font-size: 23rpx; }
.risk-alert { margin-top: 14rpx; padding: 18rpx; border-left: 7rpx solid #d49a3c; border-radius: 18rpx; background: #fff8ea; }
.risk-alert.severity-critical, .risk-alert.severity-high { border-left-color: #c95365; background: #fff0f3; }
.risk-title, .risk-summary, .risk-source { display: block; }
.risk-title { color: #3c332a; font-size: 25rpx; font-weight: 800; }
.risk-summary { margin-top: 8rpx; color: #5c5247; font-size: 22rpx; line-height: 1.6; }
.risk-source { margin-top: 10rpx; color: #7b6f62; font-size: 19rpx; word-break: break-all; }
.emergency-button { margin-top: 14rpx; color: #8a3f4f; background: #fff0f3; border-radius: 20rpx; font-size: 25rpx; }
.emergency-button.danger { color: #fff; background: #d45a6e; }
.emergency-note { display: block; margin-top: 16rpx; color: #7b6f62; font-size: 22rpx; line-height: 1.65; }
.bottom-space { height: 50rpx; }
