@import "../../templates/tabbar.wxss";

page{
    background:
        radial-gradient(circle at top left, rgba(230, 193, 121, 0.38) 0, rgba(230, 193, 121, 0) 28%),
        linear-gradient(180deg, #f7f1e7 0%, #f2ece2 48%, #f2ece2 100%);
}

.profile-page{
    min-height: 100vh;
}

.profile-scroll{
    min-height: 100vh;
}

.profile-content{
    padding: 40rpx 28rpx 220rpx;
}

.profile-hero,
.section-card{
    border-radius: 34rpx;
    border: 1rpx solid rgba(230, 218, 199, 0.9);
    box-shadow: 0 24rpx 54rpx rgba(90, 60, 30, 0.10);
}

.profile-hero{
    padding: 34rpx 30rpx 30rpx;
    background:
        radial-gradient(circle at top right, rgba(255, 253, 248, 0.92) 0, rgba(255, 255, 255, 0) 34%),
        linear-gradient(140deg, #efe4d2 0%, #f7ece0 44%, #fff8ed 100%);
}

.hero-topline{
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hero-badge,
.hero-date,
.section-pill,
.journey-chip,
.hero-status-pill{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999rpx;
}

.hero-badge{
    padding: 10rpx 18rpx;
    font-size: 20rpx;
    color: #0f766e;
    background: rgba(255, 253, 248, 0.86);
    letter-spacing: 2rpx;
}

.hero-date{
    padding: 10rpx 16rpx;
    font-size: 20rpx;
    color: #8a6d46;
    background: rgba(255, 247, 232, 0.9);
}

.identity-row{
    margin-top: 28rpx;
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.avatar-shell{
    width: 132rpx;
    height: 132rpx;
    border-radius: 38rpx;
    background: rgba(255, 253, 248, 0.72);
    box-shadow: inset 0 2rpx 8rpx rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
}

.avatar-image{
    width: 100%;
    height: 100%;
}

.avatar-fallback{
    width: 92rpx;
    height: 92rpx;
    border-radius: 28rpx;
    background: linear-gradient(135deg, #6fcba8 0%, #3bb492 100%);
    color: #ffffff;
    font-size: 42rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

.identity-copy{
    flex: 1;
}

.hero-name{
    display: block;
    font-size: 44rpx;
    line-height: 1.12;
    font-weight: 800;
    color: #2a231c;
}

.hero-subcopy{
    display: block;
    margin-top: 12rpx;
    font-size: 23rpx;
    color: #5b6473;
}

.hero-note{
    display: block;
    margin-top: 14rpx;
    font-size: 24rpx;
    line-height: 1.65;
    color: #5f6b7a;
}

.hero-login-btn,
.ghost-logout-btn{
    border: none;
}

.hero-login-btn::after,
.ghost-logout-btn::after{
    border: none;
}


.hero-status-pill{
    margin-top: 24rpx;
    padding: 14rpx 20rpx;
    font-size: 22rpx;
    color: #0f766e;
    background: rgba(237, 255, 247, 0.92);
}

.hero-status-guest{
    color: #8b5e34;
    background: rgba(255, 244, 226, 0.92);
}

.stats-grid{
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18rpx;
    margin-top: 28rpx;
}

.stat-card{
    padding: 24rpx;
    border-radius: 26rpx;
    background: rgba(255, 253, 248, 0.76);
}

.stat-emerald{
    background: linear-gradient(135deg, #e8fbf3 0%, #f7fffb 100%);
}

.stat-sand{
    background: linear-gradient(135deg, #fff5e6 0%, #fffdf9 100%);
}

.stat-sky{
    background: linear-gradient(135deg, #ebf5ff 0%, #f8fbff 100%);
}

.stat-rose{
    background: linear-gradient(135deg, #fff1f4 0%, #fffafb 100%);
}

.stat-gold{
    background: linear-gradient(135deg, #fff7df 0%, #fffdf6 100%);
}

.stat-value{
    display: block;
    font-size: 32rpx;
    line-height: 1.25;
    font-weight: 700;
    color: #2a231c;
}

.stat-label{
    display: block;
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #7b6f62;
}

.section-card{
    margin-top: 24rpx;
    padding: 30rpx;
    background: rgba(255, 253, 248, 0.92);
    backdrop-filter: blur(14px);
}

.section-head{
    margin-bottom: 22rpx;
}

.section-head-row{
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20rpx;
}

.section-title{
    display: block;
    font-size: 34rpx;
    line-height: 1.25;
    font-weight: 700;
    color: #2a231c;
}

.section-subtitle{
    display: block;
    margin-top: 8rpx;
    font-size: 22rpx;
    line-height: 1.6;
    color: #8b93a1;
}

.section-pill{
    padding: 12rpx 18rpx;
    font-size: 22rpx;
    color: #0f766e;
    background: rgba(230, 250, 240, 0.9);
    flex-shrink: 0;
}


.journey-banner{
    padding: 26rpx;
    border-radius: 28rpx;
    background:
        radial-gradient(circle at top right, rgba(255, 255, 255, 0.68) 0, rgba(255, 255, 255, 0) 30%),
        linear-gradient(135deg, #d8f4e8 0%, #f7f1e7 52%, #fff6e7 100%);
}

.journey-title{
    display: block;
    font-size: 34rpx;
    font-weight: 700;
    color: #2a231c;
}

.journey-desc{
    display: block;
    margin-top: 14rpx;
    font-size: 24rpx;
    color: #566170;
    line-height: 1.7;
}

.journey-chip-row{
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 18rpx;
}

.journey-chip{
    padding: 12rpx 18rpx;
    font-size: 22rpx;
}

.journey-chip-green{
    color: #0f766e;
    background: rgba(231, 251, 241, 0.92);
}

.journey-chip-amber{
    color: #a16207;
    background: rgba(255, 244, 212, 0.92);
}


.service-arrow{
    font-size: 36rpx;
    color: #b7c0cb;
}

.empty-bookmarks{
    padding: 34rpx 24rpx;
    border-radius: 28rpx;
    background: linear-gradient(180deg, #f9fbfc 0%, #f2ece2 100%);
    text-align: center;
}

.empty-icon{
    width: 84rpx;
    height: 84rpx;
    margin: 0 auto;
    border-radius: 28rpx;
    background: linear-gradient(135deg, #e7fbf2 0%, #fff4df 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38rpx;
    color: #158c75;
}

.empty-title{
    display: block;
    margin-top: 18rpx;
    font-size: 28rpx;
    color: #2a231c;
    font-weight: 700;
}

.empty-desc{
    display: block;
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #7b6f62;
    line-height: 1.65;
}

.bookmark-item{
    display: flex;
    align-items: center;
    gap: 18rpx;
    padding: 20rpx 0;
    border-bottom: 1rpx solid rgba(226, 232, 240, 0.76);
}

.bookmark-item:last-child{
    border-bottom: none;
    padding-bottom: 0;
}

.bookmark-main{
    flex: 1;
}

.bookmark-title{
    display: block;
    font-size: 28rpx;
    color: #2a231c;
    font-weight: 700;
    line-height: 1.45;
}

.bookmark-meta-row{
    display: flex;
    align-items: center;
    gap: 14rpx;
    margin-top: 10rpx;
    flex-wrap: wrap;
}

.bookmark-tag{
    padding: 8rpx 14rpx;
    border-radius: 999rpx;
    font-size: 20rpx;
    color: #0f766e;
    background: rgba(230, 250, 240, 0.92);
}

.bookmark-date{
    font-size: 22rpx;
    color: #8b93a1;
}

.bookmark-remove{
    padding: 12rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(255, 243, 245, 0.92);
    color: #c2415d;
    font-size: 22rpx;
    flex-shrink: 0;
}


.ghost-logout-btn{
    margin-top: 22rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 999rpx;
    background: rgba(247, 250, 252, 0.96);
    color: #5c5247;
    font-size: 26rpx;
    font-weight: 600;
}

.admin-entry-card{
    margin-top: 18rpx;
    padding: 24rpx 26rpx;
    border-radius: 28rpx;
    background: linear-gradient(135deg, #2a231c 0%, #374151 100%);
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.admin-entry-copy{
    flex: 1;
}

.admin-entry-title{
    display: block;
    font-size: 28rpx;
    line-height: 1.25;
    font-weight: 700;
    color: #ffffff;
}

.admin-entry-desc{
    display: block;
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(230, 218, 199, 0.9);
    line-height: 1.5;
}

.admin-entry-arrow{
    color: #ffffff;
    font-size: 42rpx;
    line-height: 1;
}

.settings-row{ display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid rgba(148, 163, 184, 0.18); }
.settings-title, .settings-desc{ display: block; }
.settings-title{ color: #2a231c; font-size: 27rpx; font-weight: 700; }
.settings-desc{ margin-top: 8rpx; color: #7b6f62; font-size: 21rpx; }
.delete-account-btn{ margin-top: 24rpx; border-radius: 999rpx; background: #fff3f5; color: #c2415d; font-size: 24rpx; }
.delete-account-btn::after{ border: 0; }

/* 9:16 mobile minimal theme */
page{ background: #f7f1e7; }
.profile-content{ padding: calc(var(--safe-top) + 24rpx) 24rpx calc(env(safe-area-inset-bottom) + 190rpx); }
.profile-hero, .section-card{ border-radius: 24rpx; background: #fffdf8; border: 1rpx solid #e6dac7; box-shadow: none; }
.profile-hero{ padding: 28rpx 24rpx; }
.hero-badge, .hero-date, .hero-status-pill{ color: #5f6f66; background: #f2ece2; }
.avatar-shell{ border-radius: 24rpx; background: #f2ece2; box-shadow: none; }
.avatar-fallback{ border-radius: 20rpx; background: #71877b; }
.hero-name, .section-title{ color: #2a231c; }
.stat-card, .quick-item{ background: #f2ece2; border: 1rpx solid #e2e6e3; }
.stat-emerald, .stat-sand, .stat-sky, .stat-rose, .stat-gold,


.journey-banner, .admin-entry-card{ background: #f2ece2; box-shadow: none; }
.admin-entry-title{ color: #3a463a; }
.admin-entry-desc, .admin-entry-arrow{ color: #66736b; }

.delete-account-btn{ border-radius: 20rpx; background: #f3eeee; color: #855d64; }

.profile-login-btn{
    margin-top: 20rpx;
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 22rpx;
    background: #4f6b52;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    border: none;
}
.profile-login-btn::after{ border: none; }

/* 头像即上传入口：button 只做承载，外观仍由 .avatar-shell 决定 */
.avatar-button{ padding: 0; margin: 0; line-height: 1; background: transparent; }
.avatar-button::after{ border: none; }

.profile-edit-row{ margin-top: 20rpx; display: flex; align-items: center; gap: 16rpx; }
.profile-nickname-input{
    flex: 1;
    height: 84rpx;
    padding: 0 24rpx;
    border-radius: 20rpx;
    background: #fffdf8;
    border: 1rpx solid #e6dac7;
    color: #2a231c;
    font-size: 28rpx;
    box-sizing: border-box;
}
.profile-input-placeholder{ color: #9aa5a0; }
.profile-save-btn{
    flex-shrink: 0;
    min-width: 180rpx;
    height: 84rpx;
    line-height: 84rpx;
    padding: 0 28rpx;
    border-radius: 20rpx;
    background: #4f6b52;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 600;
    border: none;
}
.profile-save-btn::after{ border: none; }

