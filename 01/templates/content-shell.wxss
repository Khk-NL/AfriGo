/* Shared travel content shell */
page {
  background: linear-gradient(180deg, #f7fbff 0%, #fffaf4 100%);
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC', 'Helvetica Neue', sans-serif;
}

.page-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.74) 0, rgba(255, 255, 255, 0) 32%),
    linear-gradient(180deg, #f7fbff 0%, #fffaf4 100%);
}

.page-scroll {
  min-height: 100vh;
}

.page-content {
  padding: calc(env(safe-area-inset-top) + 110rpx) 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.page-back-btn {
  position: absolute;
  left: 24rpx;
  top: calc(env(safe-area-inset-top) + 24rpx);
  z-index: 20;
  min-width: 176rpx;
  height: 72rpx;
  padding: 0 22rpx 0 16rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(214, 231, 253, 0.95);
  box-shadow: 0 10rpx 22rpx rgba(150, 180, 220, 0.16);
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.page-back-btn:active {
  transform: translateY(1rpx);
  box-shadow: 0 6rpx 16rpx rgba(150, 180, 220, 0.18);
}

.page-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #254567;
  border-bottom: 4rpx solid #254567;
  transform: rotate(45deg);
  margin-left: 4rpx;
  flex-shrink: 0;
}

.page-back-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #24476f;
}

.hero-card,
.section-card,
.empty-state {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 18rpx 40rpx rgba(84, 70, 51, 0.08);
  backdrop-filter: blur(14px);
}

.hero-card {
  padding: 32rpx 30rpx 28rpx;
}

.hero-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #b7791f;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 50rpx;
  line-height: 1.16;
  color: #1f2937;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7c674c;
  line-height: 1.5;
}

.hero-summary {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.hero-chip-row,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-chip,
.tag-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.hero-chip-row {
  margin-top: 20rpx;
}

.tag-text {
  color: inherit;
  font-size: inherit;
  font-weight: 600;
  line-height: 1;
}

.hero-chip {
  color: #9a6a1b;
  background: rgba(255, 240, 217, 0.9);
}

.section-card {
  margin-top: 26rpx;
  padding: 28rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b7a67;
  line-height: 1.55;
}

.search-shell {
  height: 74rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(214, 231, 253, 0.95);
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.8), 0 8rpx 18rpx rgba(150, 180, 220, 0.08);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.search-icon {
  color: #8ea0b6;
  margin-right: 10rpx;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  font-size: 28rpx;
  color: #243447;
}

.search-placeholder {
  color: #b2aaa0;
}

.clear-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #c0c6cf;
  padding: 0 6rpx 0 16rpx;
}

.tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.tag-row {
  flex-wrap: nowrap;
  padding: 2rpx 2rpx 10rpx;
}

.tag-pill {
  flex-shrink: 0;
  color: #5a6677;
  background: rgba(242, 246, 250, 0.96);
  border: 1rpx solid rgba(221, 231, 240, 0.98);
}

.tag-pill:active {
  transform: translateY(1rpx);
}

.item-card {
  padding: 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #ffffff 100%);
  border: 1rpx solid rgba(240, 211, 172, 0.64);
  box-shadow: 0 12rpx 26rpx rgba(150, 180, 220, 0.08);
}

.item-card + .item-card {
  margin-top: 18rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.item-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  color: #202938;
  font-weight: 700;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.item-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.item-note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 240, 243, 0.72);
  font-size: 22rpx;
  color: #3a4758;
  line-height: 1.6;
}

.empty-state {
  margin-top: 18rpx;
  padding: 42rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 44rpx;
}

.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #243447;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

