<view class="page-root">
  <view class="page-back-btn" bindtap="onBackTap">
    <text class="page-back-icon">←</text>
    <text class="page-back-text">返回上一页</text>
  </view>

  <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false">
    <view class="page-content">
      <view class="hero-card">
        <text class="hero-eyebrow">LOCAL PHRASES</text>
        <text class="hero-title">{{currentCountry}}·实用语句</text>
        <text class="hero-subtitle">日常、应急与医疗场景的高频表达，支持离线查看。</text>
        <view class="hero-chip-row">
          <text class="hero-chip">共 {{fullList.length}} 条</text>
          <text class="hero-chip">场景分类</text>
          <text class="hero-chip">可收藏</text>
        </view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">搜索与分类</text>
          <text class="section-subtitle">支持按中文、当地语和读音提示搜索</text>
        </view>
        <view class="search-shell">
          <text class="search-icon">⌕</text>
          <input class="search-input" placeholder="输入关键词搜索..." bindinput="onSearchInput" value="{{searchKey}}" />
          <text wx:if="{{searchKey}}" class="clear-icon" bindtap="onClearSearch">×</text>
        </view>
        <scroll-view class="tag-scroll" scroll-x="true" show-scrollbar="false">
          <view class="tag-row phrase-tags">
            <block wx:for="{{categories}}" wx:key="*this">
              <view class="tag-pill {{activeCategory === item ? 'active-pill' : ''}}" bindtap="onTagTap" data-tag="{{item}}"><text class="tag-text">{{item}}</text></view>
            </block>
          </view>
        </scroll-view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">语句清单</text>
          <text class="section-subtitle">点击有音频的条目可播放发音</text>
        </view>
        <block wx:if="{{displayList.length}}">
          <block wx:for="{{displayList}}" wx:key="id">
            <view class="item-card phrase-card" bindtap="onPlayAudio" data-id="{{item.id}}">
              <view class="item-head">
                <text class="phrase-type">{{item.type}}</text>
                <text class="phrase-audio">{{item.audio ? '🔊' : '🔇'}}</text>
              </view>
              <text class="item-title phrase-cn">{{item.cn}}</text>
              <text class="phrase-foreign">{{item.foreign}}</text>
              <view wx:if="{{item.konger}}" class="phrase-pronunciation">🗣️ 跟着念：{{item.konger}}</view>
              <view class="bookmark-action {{item.isBookmarked ? 'bookmarked' : ''}}" catchtap="onBookmarkTap" data-id="{{item.id}}">{{item.isBookmarked ? '★ 已收藏' : '☆ 收藏'}}</view>
            </view>
          </block>
        </block>
        <view wx:else class="empty-state">
          <text class="empty-icon">💬</text>
          <text class="empty-title">{{noData ? '该国家暂无经核验的常用语资料' : '没有匹配的语句'}}</text>
          <text class="empty-desc">{{noData ? '未核验的翻译不会作为其他国家的默认内容。' : '请更换关键词或切换分类。'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
<elephant-pet />
