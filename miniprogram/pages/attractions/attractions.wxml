<view class="page-root">
  <view class="page-back-btn" bindtap="onBackTap">
    <text class="page-back-icon">←</text>
    <text class="page-back-text">返回上一页</text>
  </view>

  <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false"
    refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="page-content">
      <view class="hero-card">
        <text class="hero-eyebrow">PLACES TO EXPLORE</text>
        <text class="hero-title">{{currentCountry}}·必游之地</text>
        <text class="hero-subtitle">景点攻略、安全提示与出行要点统一整理。</text>
        <view class="hero-chip-row">
          <text class="hero-chip">共 {{fullList.length}} 处</text>
          <text class="hero-chip">安全优先</text>
          <text class="hero-chip">可收藏</text>
        </view>
      </view>

      <text wx:if="{{freshnessText}}" class="freshness-line">{{freshnessText}}</text>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">搜索与筛选</text>
          <text class="section-subtitle">按景点名称、体验或标签快速定位</text>
        </view>
        <view class="search-shell">
          <text class="search-icon">⌕</text>
          <input class="search-input" value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索景点或体验..." />
        </view>
        <scroll-view class="tag-scroll" scroll-x="true" show-scrollbar="false">
          <view class="tag-row attraction-tags">
            <block wx:for="{{tags}}" wx:key="*this">
              <view class="tag-pill {{activeTag === item ? 'active-pill' : ''}}" bindtap="onTagTap" data-tag="{{item}}"><text class="tag-text">{{item}}</text></view>
            </block>
          </view>
        </scroll-view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">景点清单</text>
          <text class="section-subtitle">点击卡片查看完整攻略与避坑提示</text>
        </view>
        <view wx:if="{{loading}}" class="skeleton-list">
          <view class="skeleton-card"></view>
          <view class="skeleton-card"></view>
          <view class="skeleton-card"></view>
        </view>
        <block wx:elif="{{list.length}}">
          <block wx:for="{{list}}" wx:key="id">
            <view class="item-card attraction-card" bindtap="onAttrTap" data-id="{{item.id}}">
              <image class="attraction-image" src="{{item.image}}" mode="aspectFill" />
              <view class="attraction-body">
                <view class="tag-row attraction-item-tags">
                  <text class="attraction-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                </view>
                <text class="item-title">{{item.name}}</text>
                <text class="item-desc">{{item.desc}}</text>
                <view wx:if="{{item.tips}}" class="item-note">💡 {{item.tips}}</view>
                <view class="bookmark-action {{item.isBookmarked ? 'bookmarked' : ''}}" catchtap="onBookmarkTap" data-id="{{item.id}}">{{item.isBookmarked ? '★ 已收藏' : '☆ 收藏'}}</view>
              </view>
            </view>
          </block>
        </block>
        <view wx:else class="empty-state">
          <text class="empty-icon">🌄</text>
          <text class="empty-title">{{noData ? '该国家暂无经核验的景点资料' : '没有匹配的景点'}}</text>
          <text class="empty-desc">{{noData ? '可稍后重试远程同步，或由管理员补充来源明确的数据。' : '请更换关键词或选择“全部”。'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
<elephant-pet />
