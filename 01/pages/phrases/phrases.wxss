@import "../../templates/content-shell.wxss";

.phrase-tags { margin-top: 20rpx; }
.active-pill { color: #ffffff; background: #65a985; border-color: #65a985; }
.phrase-type { padding: 8rpx 14rpx; border-radius: 999rpx; color: #39775b; background: #e7f6ee; font-size: 20rpx; }
.phrase-audio { font-size: 34rpx; }
.phrase-cn { margin-top: 18rpx; }
.phrase-foreign { display: block; margin-top: 10rpx; color: #5f24b6; font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.phrase-pronunciation { display: inline-flex; margin-top: 14rpx; padding: 10rpx 16rpx; border-radius: 14rpx; color: #9a5a18; background: #fff5e8; font-size: 24rpx; }
.bookmark-action { margin-top: 18rpx; color: #7a6848; font-size: 26rpx; }
.bookmark-action.bookmarked { color: #c28a24; }
