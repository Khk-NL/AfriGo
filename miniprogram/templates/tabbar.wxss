/* miniprogram/templates/tabbar.wxss */
.custom-tabbar {
    position: fixed;
    bottom: calc(constant(safe-area-inset-bottom) + 8px);
    bottom: calc(env(safe-area-inset-bottom) + 8px);
    left: 0;
    width: 100%;
    background: transparent;
    box-shadow: none;
    z-index: 9999;
    display: flex;
    justify-content: center;
    pointer-events: auto;
}

.tab-pill {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 66px;
    width: calc(100% - 32rpx);
    padding: 0 12rpx;
    box-sizing: border-box;
    border-radius: 24rpx;
    background: rgba(255, 253, 248, 0.97);
    border: 1rpx solid #e6dac7;
    box-shadow: 0 10rpx 26rpx rgba(90, 60, 30, 0.12);
    pointer-events: auto;
    position: relative;
    overflow: hidden;
}

.tab-pill::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 5rpx;
    background-image:
        repeating-linear-gradient(135deg, #b4552f 0 6rpx, transparent 6rpx 12rpx),
        repeating-linear-gradient(45deg, #d8a13a 0 6rpx, transparent 6rpx 12rpx),
        linear-gradient(90deg, #2f4a3c, #2f4a3c);
    opacity: .75;
}

.tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    color: #7b6f62;
    font-size: 12px;
    position: relative;
    transition: color 0.25s ease;
}

/* 当前页：加深加粗 + 图标上浮放大 + 下方指示条，确保一眼看出在哪一页 */
.tab-item.active {
    color: #8c3f22;
    font-weight: 700;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-icon-image {
    transform: translateY(-3rpx) scale(1.14);
}

.tab-item.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4rpx;
    width: 26rpx;
    height: 6rpx;
    margin-left: -13rpx;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #b4552f, #d8a13a);
}

/* 中间的发布按钮本身有底色，不再叠加指示条 */
.tab-item.center-item.active::after {
    display: none;
}

.tab-icon {
    font-size: 20px;
    margin-bottom: 4rpx;
    transition: transform 0.25s ease;
}

.tab-icon-image {
    width: 32rpx;
    height: 32rpx;
    margin-bottom: 4rpx;
    transition: transform 0.25s ease;
}

.publish-icon-image {
    width: 38rpx;
    height: 38rpx;
}

.tab-text {
    font-size: 10px;
}

/* Center "Publish" button styling */
.center-item {
    position: relative;
    bottom: 0;
    width: auto;
    height: auto;
    border-radius: 50%;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    color: #4f6659;
}

.publish-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    background: linear-gradient(150deg, #b4552f, #8c3f22);
    box-shadow: 0 8rpx 16rpx rgba(140, 63, 34, .28);
}

.publish-plus {
    font-size: 38rpx;
    line-height: 1;
    color: #fff;
}

.publish-text {
    font-size: 20rpx;
    margin-top: 4rpx;
    color: #7b6f62;
}
