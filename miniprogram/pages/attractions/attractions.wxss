@import "../../templates/content-shell.wxss";

.attraction-tags { margin-top: 20rpx; }
.active-pill { color: #ffffff; background: #c18a3c; border-color: #c18a3c; }
.attraction-card { padding: 0; overflow: hidden; }
.attraction-image { display: block; width: 100%; height: 330rpx; background: #eef1f3; }
.attraction-body { padding: 24rpx; }
.attraction-item-tags { margin-bottom: 14rpx; }
.attraction-tag { padding: 8rpx 14rpx; border-radius: 999rpx; background: #fff0d9; color: #9a6a1b; font-size: 20rpx; }
.bookmark-action { margin-top: 18rpx; color: #7a6848; font-size: 26rpx; }
.bookmark-action.bookmarked { color: #c28a24; }

.freshness-line { display: block; margin-top: 16rpx; color: #8b968f; font-size: 22rpx; }

.skeleton-list { margin-top: 18rpx; }
.skeleton-card {
  height: 200rpx;
  background: #eef1ef;
  border-radius: 20rpx;
  animation: skeletonPulse 1.4s ease-in-out infinite;
}
.skeleton-card + .skeleton-card { margin-top: 18rpx; }

@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
