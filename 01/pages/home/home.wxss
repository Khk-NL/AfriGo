@import "../../templates/tabbar.wxss";

page { background: #f4f5f3; color: #24302a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif; }
.page-root { min-height: 100vh; background: #f4f5f3; overflow: hidden; }
.page-scroll { height: 100vh; }
.page-content { box-sizing: border-box; width: 100%; padding: calc(env(safe-area-inset-top) + 112rpx) 24rpx calc(env(safe-area-inset-bottom) + 190rpx); }
.home-topbar { position: fixed; z-index: 100; top: 0; left: 0; right: 0; height: calc(env(safe-area-inset-top) + 92rpx); padding: calc(env(safe-area-inset-top) + 14rpx) 24rpx 12rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; background: rgba(244, 245, 243, 0.94); backdrop-filter: blur(12px); }
.home-back-wrap { width: 64rpx; height: 64rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: #fff; border: 1rpx solid #dde2de; }
.home-back-icon { color: #46534c; font-size: 32rpx; }
.destination-pill { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 18rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #dde2de; color: #526058; font-size: 22rpx; }

.ai-hero-container { position: relative; width: 100%; height: 332rpx; overflow: hidden; border-radius: 28rpx; background: #e8ece8; border: 1rpx solid #dce2dd; }
.hero-text-area { position: relative; z-index: 3; width: 58%; padding: 42rpx 0 0 30rpx; box-sizing: border-box; }
.hero-kicker { display: block; color: #748278; font-size: 18rpx; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 16rpx; color: #223129; font-size: 42rpx; line-height: 1.22; font-weight: 750; }
.hero-subtitle { display: block; margin-top: 12rpx; color: #69756d; font-size: 22rpx; }
.elephant-interaction-area { position: absolute; right: -10rpx; bottom: -8rpx; width: 280rpx; height: 280rpx; transition: transform .35s ease; }
.elephant-interaction-area.hidden { transform: translateX(64rpx); }
.elephant-interaction-area.revealed { transform: translateX(0); }
.elephant-wrapper { position: relative; width: 224rpx; height: 224rpx; margin: 20rpx auto 0; }
.elephant-canvas { transform: scaleX(-1); transform-origin: center; }
.elephant-tooltip { position: absolute; right: 180rpx; top: 36rpx; opacity: 0; width: max-content; max-width: 250rpx; padding: 12rpx 16rpx; border-radius: 16rpx; background: rgba(255,255,255,.96); color: #526058; font-size: 20rpx; line-height: 1.45; box-shadow: 0 8rpx 18rpx rgba(45, 58, 50, .08); pointer-events: none; transition: opacity .2s ease; }
.elephant-tooltip.show { opacity: 1; }

.safety-card { box-sizing: border-box; width: 100%; margin-top: 16rpx; padding: 20rpx 22rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #e4ebe6; border: 1rpx solid #d6dfd8; }
.safety-main { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.safety-icon { font-size: 36rpx; }
.safety-title, .safety-level { display: block; }
.safety-title { color: #31423a; font-size: 27rpx; font-weight: 700; }
.safety-level { margin-top: 5rpx; color: #718078; font-size: 20rpx; }
.safety-more { flex-shrink: 0; color: #5b7064; font-size: 21rpx; }

.home-section { margin-top: 32rpx; }
.home-section-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16rpx; }
.home-section-title, .home-section-subtitle { display: block; }
.home-section-title, .feature-title { color: #27332d; font-size: 30rpx; font-weight: 750; }
.home-section-subtitle { margin-top: 6rpx; color: #849087; font-size: 20rpx; }
.journey-tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.journey-tool-card { min-width: 0; padding: 20rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 14rpx; background: #fff; border: 1rpx solid #e1e5e2; }
.tool-icon-emoji, .service-row-icon { flex-shrink: 0; font-size: 36rpx; }
.tool-icon-image, .feature-icon-image, .service-row-icon-image { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.tool-copy { min-width: 0; }
.tool-title, .tool-desc { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tool-title { color: #334139; font-size: 25rpx; font-weight: 700; }
.tool-desc { margin-top: 5rpx; color: #8a948e; font-size: 19rpx; }

.landing-plan-card { margin-top: 30rpx; padding: 24rpx; border-radius: 24rpx; display: flex; align-items: center; gap: 18rpx; background: #edf0eb; border: 1rpx solid #dce2dc; }
.landing-plan-copy { flex: 1; min-width: 0; }
.landing-plan-eyebrow, .landing-plan-title, .landing-plan-desc { display: block; }
.landing-plan-eyebrow { color: #78847c; font-size: 17rpx; letter-spacing: 2rpx; }
.landing-plan-title { margin-top: 8rpx; color: #2c3932; font-size: 29rpx; font-weight: 750; }
.landing-plan-desc { margin-top: 7rpx; color: #717d75; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.landing-plan-progress { width: 78rpx; height: 78rpx; flex-shrink: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #53695d; background: #fff; border: 5rpx solid #a9b9af; font-size: 20rpx; font-weight: 700; }

.service-list { overflow: hidden; border-radius: 24rpx; background: #fff; border: 1rpx solid #e1e5e2; }
.service-row { display: grid; grid-template-columns: 48rpx 1fr 28rpx; align-items: center; gap: 14rpx; padding: 20rpx; }
.service-row + .service-row { border-top: 1rpx solid #edf0ee; }
.service-row-title, .service-row-desc { display: block; }
.service-row-title { color: #334139; font-size: 25rpx; font-weight: 700; }
.service-row-desc { margin-top: 5rpx; color: #849087; font-size: 20rpx; }
.row-arrow { color: #a1aaa4; font-size: 34rpx; }

.feature-block { margin-top: 32rpx; }
.feature-title { display: block; margin-bottom: 16rpx; }
.feature-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22rpx 8rpx; padding: 22rpx 10rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #e1e5e2; }
.feature-item { min-width: 0; display: flex; flex-direction: column; align-items: center; }
.feature-icon-shell { width: 72rpx; height: 72rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: #eef1ee; }
.feature-icon { font-size: 34rpx; }
.feature-label { width: 100%; margin-top: 8rpx; color: #59645e; font-size: 19rpx; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bottom-space { height: 20rpx; }

/* 以常见 9:16 竖屏为基线，小屏进一步收紧而不切换桌面布局。 */
@media (max-width: 340px) {
  .page-content { padding-left: 18rpx; padding-right: 18rpx; }
  .journey-tool-card { padding: 17rpx 14rpx; }
  .tool-icon-emoji { font-size: 31rpx; }
  .tool-title { font-size: 23rpx; }
  .feature-label { font-size: 18rpx; }
}
