NODE_ENV=development
PORT=3001
HOST=0.0.0.0
PUBLIC_BASE_URL=http://127.0.0.1:3001
# 生产环境改成对外域名（必须 HTTPS）：https://afrigo-api.allezafrique.cn
# 该变量只用于启动校验，不参与拼接任何 URL。
CORS_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afrigo
DB_USER=afrigo
DB_PASSWORD=replace-with-a-strong-password
DB_APP_HOST=127.0.0.1
# 仅首次创建数据库或应用账号时使用，完成后从运行环境删除。
DB_ROOT_PASSWORD=

WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
SESSION_TTL_DAYS=7

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-private-bucket-name
# 媒体存储：oss（阿里云私有 Bucket + 签名 URL）| local（服务器本地磁盘，经 /media 前缀提供）。
# 留空时自动判断：OSS 凭据齐全走 oss，否则退回 local，保证图片上传/头像功能立即可用。
STORAGE_PROVIDER=
# 本地开发使用 environment；阿里云 ECS 正式环境改为 ecs_ram_role。
# 轻量应用服务器（SAS）没有"实例 RAM 角色"，只能用 environment + RAM 用户 AccessKey。
# environment 模式下即使没填 AccessKey 也能启动（仅告警）；此时媒体会自动落到
# STORAGE_PROVIDER=local 的本地磁盘存储，图片与头像照常可用。
OSS_CREDENTIAL_MODE=environment
OSS_ACCESS_KEY_ID=replace-with-ram-user-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-user-access-key-secret
OSS_SESSION_TOKEN=
# ECS 模式填写实例 RAM Role 名称，同时删除上面的长期 AccessKey。
ALIBABA_CLOUD_ECS_METADATA=
ALIBABA_CLOUD_IMDSV1_DISABLE=true

# 阿里云机器翻译（默认关闭，开通产品并为 ECS RAM Role 授权后再开启）
ALIYUN_TRANSLATE_ENABLED=false
ALIYUN_TRANSLATE_REGION=cn-hangzhou
ALIYUN_TRANSLATE_ENDPOINT=mt.cn-hangzhou.aliyuncs.com

# 地图/路线预估：可替换 Provider，取值 amap-overseas | mapbox | google-directions | tencent | disabled。
# 客户端展示名由服务端下发，切换 Provider 不需要改动小程序。
NAVIGATION_PROVIDER=amap-overseas
# 高德海外 Web Service：需企业开发者认证并工单开通海外 LBS 权限，未开通时保持关闭和留空。
AMAP_NAVIGATION_ENABLED=false
AMAP_WEB_SERVICE_KEY=
AMAP_NAVIGATION_BASE_URL=https://sg-restapi.opnavi.com/v3/direction
# Mapbox Directions：自助注册即可用、覆盖全球，可替代尚未开通的高德海外权限。
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5/mapbox
# Google Directions：需 Google Cloud 项目并绑定结算账号。
GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_BASE_URL=https://maps.googleapis.com/maps/api/directions/json
# 腾讯位置服务 Direction：在控制台自助申请 Key 即可用，个人开发者也有免费配额。
TENCENT_MAP_KEY=
TENCENT_DIRECTIONS_BASE_URL=https://apis.map.qq.com/ws/direction/v1
# 配置了绑定 OSS/CDN 的 HTTPS 域名时填写；留空则由服务端生成短期签名 URL。
OSS_PUBLIC_BASE_URL=
OSS_SIGNED_URL_EXPIRES=3600

# 仅允许在非 production 环境开启。
ALLOW_DEV_AUTH=false
DEV_AUTH_OPENID=dev-user

# AI 对话（大象）Provider：可替换，取值 deepseek | disabled。
# 留空时默认 deepseek；未配置 DEEPSEEK_API_KEY 时接口返回 503，其余功能不受影响。
AI_PROVIDER=deepseek
# DeepSeek 开放平台 API Key（https://platform.deepseek.com/），只存在服务端，绝不下发小程序。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：整体覆盖大象的人设提示词（backend/src/chat/persona.js 的 PERSONA_BODY）。
# 留空时使用内置人设，并自动追加本次请求国家的资料要点。
AI_SYSTEM_PROMPT=
