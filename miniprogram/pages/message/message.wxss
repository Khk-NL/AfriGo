/* miniprogram/pages/message/message.wxss */
@import "../../templates/content-shell.wxss";
@import "../../templates/tabbar.wxss";

.page-root {
  background: #f7f1e7;
}

/* tab 页：底部给固定 tabbar 留位置 */
.message-content {
  padding: calc(var(--safe-top) + 28rpx) 24rpx calc(env(safe-area-inset-bottom) + 200rpx);
}

.message-hero {
  border-left: 6rpx solid #b4552f;
}

.unread-pill {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #f6ece5;
  color: #8c3f22;
  font-size: 22rpx;
}

.notice-hint {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f2ece2;
  color: #7b6f62;
  font-size: 23rpx;
  line-height: 1.5;
}

.notice-list {
  margin-top: 8rpx;
}

.notice-card {
  position: relative;
  margin-top: 18rpx;
  padding: 26rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  border: 1rpx solid #e6dac7;
  box-shadow: 0 10rpx 24rpx rgba(90, 60, 30, .07);
}

/* 未读：左侧一道陶土色书脊 + 极淡暖底，比原来的薄荷绿更贴全站 */
.notice-card.is-unread {
  background: #fffaf2;
  border-left: 8rpx solid #b4552f;
}

.notice-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.card-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.tag-sage {
  background: #e4ebe0;
  color: #3f5a44;
}

.tag-sand {
  background: #f2e7d5;
  color: #8c5a2b;
}

.tag-clay {
  background: #f6e3d9;
  color: #8c3f22;
}

.notice-time {
  font-size: 22rpx;
  color: #948779;
}

.notice-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  color: #2a231c;
}

.notice-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5c5247;
}

.unread-dot {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b4552f;
}
