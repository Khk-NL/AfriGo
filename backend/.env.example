NODE_ENV=development
PORT=3001
HOST=0.0.0.0
PUBLIC_BASE_URL=http://127.0.0.1:3001
CORS_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afrigo
DB_USER=afrigo
DB_PASSWORD=replace-with-a-strong-password
DB_APP_HOST=127.0.0.1
# 仅首次创建数据库或应用账号时使用，完成后从运行环境删除。
DB_ROOT_PASSWORD=

WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
SESSION_TTL_DAYS=7

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-private-bucket-name
# 本地开发使用 environment；阿里云 ECS 正式环境改为 ecs_ram_role。
OSS_CREDENTIAL_MODE=environment
OSS_ACCESS_KEY_ID=replace-with-ram-user-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-user-access-key-secret
OSS_SESSION_TOKEN=
# ECS 模式填写实例 RAM Role 名称，同时删除上面的长期 AccessKey。
ALIBABA_CLOUD_ECS_METADATA=
ALIBABA_CLOUD_IMDSV1_DISABLE=true

# 阿里云机器翻译（默认关闭，开通产品并为 ECS RAM Role 授权后再开启）
ALIYUN_TRANSLATE_ENABLED=false
ALIYUN_TRANSLATE_REGION=cn-hangzhou
ALIYUN_TRANSLATE_ENDPOINT=mt.cn-hangzhou.aliyuncs.com

# 地图/路线预估：可替换 Provider，取值 amap-overseas | mapbox | google-directions | disabled。
# 客户端展示名由服务端下发，切换 Provider 不需要改动小程序。
NAVIGATION_PROVIDER=amap-overseas
# 高德海外 Web Service：需企业开发者认证并工单开通海外 LBS 权限，未开通时保持关闭和留空。
AMAP_NAVIGATION_ENABLED=false
AMAP_WEB_SERVICE_KEY=
AMAP_NAVIGATION_BASE_URL=https://sg-restapi.opnavi.com/v3/direction
# Mapbox Directions：自助注册即可用、覆盖全球，可替代尚未开通的高德海外权限。
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5/mapbox
# Google Directions：需 Google Cloud 项目并绑定结算账号。
GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_BASE_URL=https://maps.googleapis.com/maps/api/directions/json
# 配置了绑定 OSS/CDN 的 HTTPS 域名时填写；留空则由服务端生成短期签名 URL。
OSS_PUBLIC_BASE_URL=
OSS_SIGNED_URL_EXPIRES=3600

# 仅允许在非 production 环境开启。
ALLOW_DEV_AUTH=false
DEV_AUTH_OPENID=dev-user
